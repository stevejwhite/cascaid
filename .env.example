# npm run dev copies this to an ignored .env on first start.
API_PORT=8105
WEB_PORT=3105
API_BASE_URL=http://127.0.0.1:8105

# fake: deterministic in-process models (no install). local: verified native llama.cpp server.
MODEL_BACKEND=fake
MODEL_TIMEOUT_SECONDS=60
LLM_BASE_URL=http://127.0.0.1:8180/v1
LLM_MODEL_ID=Qwen/Qwen3-4B-GGUF:Q4_K_M
LLM_MODEL_REVISION=bc640142c66e1fdd12af0bd68f40445458f3869b

# Interpreter (local backend only). cascade: local classifiers first, Qwen when they are
# not confident (uses the embedding server that npm run models:start also runs; falls back
# to Qwen without it). model: the Qwen interpreter on every turn.
INTERPRETER=cascade

# The fine-tuned student interpreter (docs/INTERPRETER-FINETUNE-PLAN.md). off: Qwen decides
# the topics the classifiers are unsure of. local: the student does first (npm run
# student:start), handing questions it answers "none" to back to Qwen.
STUDENT_BACKEND=off
STUDENT_BASE_URL=http://127.0.0.1:8184
# Qwen decides when the student and the topic classifier disagree (docs/STUDENT-CROSS-CHECK-PLAN.md).
STUDENT_CROSS_CHECK=all
# student (default) or reranker: what decides topics the classifiers are unsure of (docs/RERANKER-PLAN.md).
TOPIC_DECIDER=student

# Speech input. off: typing only. fake: fixed transcript for development.
# local: whisper.cpp on this machine (npm run speech:install, then npm run speech:start).
SPEECH_BACKEND=off
ASR_BASE_URL=http://127.0.0.1:8182

# The character's voice. off: replies read by an on-device browser voice. fake: silent audio
# with timings for development. local: Kokoro-82M (npm run tts:install, then npm run tts:start).
TTS_BACKEND=off
TTS_BASE_URL=http://127.0.0.1:8183

# Phase 4 only: allow consenting speakers to record evaluation prompts at /record.
RECORDINGS_ENABLED=false

# Case editor at /authoring (docs/CASE-EDITOR-PLAN.md): local development only; refused in
# production profiles. Drafts and exports go to data/authoring (git-ignored).
AUTHORING_ENABLED=false
