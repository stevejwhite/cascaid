{
  "name": "psychiatry-edu-ai",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "hardware": "node scripts/hardware.mjs",
    "dev": "node scripts/dev/start.mjs",
    "dev:stop": "node scripts/dev/stop.mjs",
    "test": "npm run test:api && npm run test:web",
    "test:api": "uv run --project services/api --locked pytest services/api/tests",
    "lint:api": "uv run --project services/api --locked ruff check services/api",
    "format:api:check": "uv run --project services/api --locked ruff format --check services/api",
    "test:web": "npm run test --workspace apps/web",
    "typecheck:web": "npm run typecheck --workspace apps/web",
    "lint:web": "npm run lint --workspace apps/web",
    "build:web": "npm run build --workspace apps/web",
    "test:e2e": "npm run test:e2e --workspace apps/web",
    "contracts:generate": "node scripts/contracts.mjs",
    "contracts:check": "node scripts/contracts.mjs --check",
    "models:install": "node scripts/models/install.mjs",
    "models:start": "node scripts/models/start.mjs",
    "models:stop": "node scripts/models/stop.mjs",
    "eval:interpreter": "uv run --project services/api --locked python -m psychiatry_api.evaluation.interpreter",
    "speech:install": "node scripts/speech/install.mjs",
    "speech:start": "node scripts/speech/start.mjs",
    "speech:stop": "node scripts/speech/stop.mjs",
    "eval:asr": "uv run --project services/api --locked python -m psychiatry_api.evaluation.asr",
    "feedback": "uv run --project services/api --locked python -m psychiatry_api.feedback",
    "eval:indicators": "uv run --project services/api --locked python -m psychiatry_api.evaluation.indicators",
    "experiment:install": "node scripts/experiments/install.mjs",
    "experiment:start": "node scripts/experiments/start.mjs",
    "experiment:stop": "node scripts/experiments/stop.mjs",
    "eval:fidelity": "uv run --project services/api --locked python -m psychiatry_api.evaluation.fidelity",
    "eval:ratings": "uv run --project services/api --locked python -m psychiatry_api.evaluation.ratings",
    "eval:agreement": "uv run --project services/api --locked python -m psychiatry_api.evaluation.ratings --agreement",
    "eval:leaks": "uv run --project services/api --locked python -m psychiatry_api.evaluation.leaks",
    "eval:rapport": "uv run --project services/api --locked python -m psychiatry_api.evaluation.rapport",
    "eval:classifier": "uv run --project services/api --locked python -m psychiatry_api.evaluation.classifier",
    "avatars:install": "node scripts/avatars/install.mjs",
    "tts:install": "node scripts/tts/install.mjs",
    "tts:start": "node scripts/tts/start.mjs",
    "tts:stop": "node scripts/tts/stop.mjs",
    "eval:voice": "uv run --project services/api --locked python -m psychiatry_api.evaluation.voice",
    "eval:hands-free": "node scripts/evaluation/hands-free.mjs",
    "eval:coverage": "uv run --project services/api --locked python -m psychiatry_api.evaluation.coverage",
    "finetune:label": "uv run --project services/api --locked python -m psychiatry_api.finetune.build label",
    "finetune:export": "uv run --project services/api --locked python -m psychiatry_api.finetune.build export",
    "finetune:score": "uv run --project services/api --locked python -m psychiatry_api.finetune.evaluate",
    "student:install": "node scripts/student/install.mjs",
    "student:start": "node scripts/student/start.mjs",
    "student:stop": "node scripts/student/stop.mjs",
    "reranker:install": "node scripts/reranker/install.mjs",
    "reranker:start": "node scripts/reranker/start.mjs",
    "reranker:stop": "node scripts/reranker/stop.mjs",
    "catalogue:doc": "uv run --project services/api --locked python -m psychiatry_api.catalogue",
    "production:prepare": "node scripts/production/cli.mjs prepare",
    "production:preflight": "node scripts/production/cli.mjs preflight",
    "production:start": "node scripts/production/cli.mjs start",
    "production:stop": "node scripts/production/cli.mjs stop",
    "production:status": "node scripts/production/cli.mjs status",
    "production:smoke": "node scripts/production/cli.mjs smoke",
    "production:service-file": "node scripts/production/cli.mjs service-file",
    "online:start": "node scripts/production/cli.mjs online-start",
    "online:stop": "node scripts/production/cli.mjs online-stop",
    "online:status": "node scripts/production/cli.mjs online-status",
    "test:production": "node --test scripts/production/tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/web"
  ]
}
